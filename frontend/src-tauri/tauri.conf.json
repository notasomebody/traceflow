{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TraceFlow",
  "version": "0.1.0",
  "identifier": "com.traceflow.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "title": "迹汇 TraceFlow",
      "width": 1440,
      "height": 900,
      "minWidth": 1120,
      "minHeight": 720,
      "center": true,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../backend/target/traceflow-backend.jar": "backend/traceflow-backend.jar"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
